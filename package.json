{
  "name": "roniforms-catalogo",
  "private": true,
  "version": "2.7.0",
  "scripts": {
    "dev": "concurrently -n API,WEB -c auto \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --ignore server/data/** --ignore server/uploads/** server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "install:all": "npm install && npm --prefix client install",
    "dev:lan": "concurrently -n API,WEB -c auto \"npm run dev:server\" \"npm run dev:client\"",
    "seed:supabase": "node scripts/seed-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10"
  },
  "type": "module"
}
